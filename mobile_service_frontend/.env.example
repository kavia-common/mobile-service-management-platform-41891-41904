# Frontend environment variables (Create React App)
#
# Copy this file to `.env` (not committed) and adjust as needed.

# Base URL of the backend API that the frontend calls (also used by scripts/wait-for-backend.js).
# Backend is reported running on port 3001.
REACT_APP_API_BASE_URL=http://localhost:3001

# Optional: disable backend health waiting before starting the dev server.
# When true/1/yes, scripts/wait-for-backend.js will skip polling /health.
BACKEND_HEALTHCHECK_DISABLED=false

# Optional tuning for scripts/wait-for-backend.js
WAIT_FOR_BACKEND_TIMEOUT_MS=60000
WAIT_FOR_BACKEND_INTERVAL_MS=2000
