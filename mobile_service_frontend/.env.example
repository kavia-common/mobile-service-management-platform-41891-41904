# Frontend -> Backend API base URL
# Used by the UI fetch client and by scripts/wait-for-backend.js
REACT_APP_API_BASE_URL=http://localhost:3001

# Disable backend readiness polling entirely (dev server starts immediately).
# Still respects BACKEND_HEALTHCHECK_DISABLED=true.
REACT_APP_DISABLE_WAIT=false

# Total time to wait for `${REACT_APP_API_BASE_URL}/health` before continuing anyway.
# On timeout, the script logs a warning and proceeds (it will NOT fail `npm start`).
REACT_APP_WAIT_MAX_SECONDS=60

# Poll interval (milliseconds) between health checks.
REACT_APP_WAIT_INTERVAL_MS=1500

# Legacy/shared toggle (optional). When true, the wait script skips polling.
# BACKEND_HEALTHCHECK_DISABLED=false
